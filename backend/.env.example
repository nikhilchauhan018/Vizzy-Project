# Server HTTP Host and Port
HOST=0.0.0.0
PORT=3000

# Django Backend Service Target (used by Node/Express HTTP reverse proxy)
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000
DJANGO_AUTO_SPAWN=true

# Django Backend Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=any-random-string-for-local-testing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon gives you this whole connection string directly — copy-paste from
# your Neon dashboard, no separate POSTGRES_DB/USER/PASSWORD needed
DATABASE_URL=postgres://user:password@ep-xxxxx.region.aws.neon.tech/vizzy?sslmode=require

# Upstash gives you this — note it's rediss:// (double-s = TLS), not redis://
REDIS_URL=rediss://default:password@xxxxx.upstash.io:6379

# From your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LLM/image provider keys — same as before, unrelated to this change
GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
STABLEHORDE_API_KEY=0000000000
HUGGINGFACE_API_KEY=

# Optional Frontend API Base URLs (defaults to relative /api/* paths)
# VITE_AUTH_API_BASE_URL=/api/auth
# VITE_STORIES_API_BASE_URL=/api/stories
